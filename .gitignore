data/smRNA_counts_CG.txt
data/smRNA_counts_RT.txt

# Genome directory not required to run the pipeline (not uploaded)
data/genome/

# Large intermediate count tables (recreated by scripts 1_*)
output/**/2_trimming/*_trimmed.txt

# OS / editor
.DS_Store
Thumbs.db
*~
*.swp
.vscode/
.idea/

# Compressed archives / logs (do not ignore data/*.txt.gz)
*.tar.gz
*.zip
*.log
